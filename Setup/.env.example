# ============================================================
# .env.example - Safe settings template for AI Trading Bot
# COPY THIS FILE TO Bot Engine/.env, then fill real values locally.
# NEVER commit .env to version control.
# ============================================================

# -- MT5 Account Credentials (LOCAL ONLY) ---------------------
MT5_LOGIN=12345678
MT5_PASSWORD=CHANGE_ME
MT5_SERVER=RoboForex-Pro
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# -- Trading Settings -----------------------------------------
SYMBOLS=XAUUSD,EURUSD
TIMEFRAME=M5
LOOP_INTERVAL=10
BARS_TO_FETCH=100

# -- Risk Management ------------------------------------------
MAX_RISK_PERCENT=2.0
MAX_CONSECUTIVE_LOSSES=3
MIN_CONFIDENCE=0.60
SL_PIPS=50
TP_PIPS=100
MIN_LOT=0.01
MAX_LOT=1.0

# -- Cloud AI Provider ----------------------------------------
AI_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=huggingface
AI_FALLBACK_ENABLED=False

# OpenRouter key stays local only.
OPENROUTER_API_KEY=CHANGE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=Investment-AI_T
OPENROUTER_SITE_URL=https://github.com/hdanial211/Investment-AI_T

# Hugging Face token is optional. Set AI_FALLBACK_ENABLED=True if you fill it.
HF_TOKEN=CHANGE_ME
HF_BASE_URL=https://router.huggingface.co/v1

# Free model defaults tested on 2026-05-25.
AI_MAIN_MODEL=openai/gpt-oss-20b:free
AI_RISK_MODEL=openai/gpt-oss-120b:free
AI_FALLBACK_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
HF_MAIN_MODEL=Qwen/Qwen3-4B-Instruct-2507
HF_RISK_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
ENABLE_RISK_REVIEW=True

# Keep startup healthcheck off by default to save free quota.
AI_STARTUP_HEALTHCHECK=False
AI_TIMEOUT=300
AI_RETRIES=2
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=256

# -- Supabase Sync (read-only Vercel dashboard integration) ----
SUPABASE_URL=CHANGE_ME
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_SYNC_ENABLED=False
SUPABASE_MACHINE_ID=laptop-main
SUPABASE_REQUEST_TIMEOUT=10

# -- Virtual Exit / Trade Management --------------------------
# Hidden exits: broker does not see fixed SL/TP. Bot must stay online.
USE_BROKER_SL_TP=False
USE_VIRTUAL_SL_TP=True
USE_VIRTUAL_TRAILING_STOP=True
VIRTUAL_EXIT_CHECK_INTERVAL=10
MAX_TRADES_PER_PAIR=10

# -- Pattern Usage Dashboard ----------------------------------
PATTERN_USAGE_SYNC_ENABLED=False
PATTERN_PRIMARY_LIMIT=1
PATTERN_CONFLUENCE_LIMIT=8
PATTERN_STATS_UPDATE_INTERVAL=10

# -- Logging ---------------------------------------------------
LOG_LEVEL=INFO

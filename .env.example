# ============================================================
# .env - Environment variables for AI Trading Bot
# COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES
# NEVER commit .env to version control!
# ============================================================

# ── MT5 Account Credentials ──────────────────────────────────
MT5_LOGIN=12345678
MT5_PASSWORD=YourRealPasswordHere
MT5_SERVER=YourBrokerServerName
# MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe  # Uncomment if needed

# ── Trading Settings ─────────────────────────────────────────
SYMBOLS=XAUUSD,EURUSD
TIMEFRAME=M5
LOOP_INTERVAL=10
BARS_TO_FETCH=100

# ── Risk Management ───────────────────────────────────────────
MAX_RISK_PERCENT=2.0
MAX_CONSECUTIVE_LOSSES=3
MIN_CONFIDENCE=0.60
SL_PIPS=50
TP_PIPS=100
MIN_LOT=0.01
MAX_LOT=1.0

# ── Ollama Settings ───────────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_TIMEOUT=60
OLLAMA_RETRIES=3

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
